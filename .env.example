# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supreme?schema=public"

# NextAuth public application URL and a strong random server-side secret.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Trust X-Forwarded-For only when the app is private behind the first public proxy.
RATE_LIMIT_TRUST_PROXY="false"

# Optional: Google OAuth. Leave both empty to disable the provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# UploadThing server token. Required for Vision Board uploads.
UPLOADTHING_TOKEN=""
